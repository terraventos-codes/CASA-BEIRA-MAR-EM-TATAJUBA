<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Casa Tatajuba — Frente-mar · Terra Ventos</title>
<meta name="description" content="Casa nova, de frente para o mar, em Tatajuba, Ceará. Terreno de ~3.100 m², 115–120 m² de área interna, estilo tropical. R$ 3.000.000.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.cdnfonts.com/css/avenir" rel="stylesheet" media="print" onload="this.media='all'">
<link href="https://fonts.cdnfonts.com/css/diodrum" rel="stylesheet" media="print" onload="this.media='all'">
<style>
  :root{
    --ink:#111827;--ink-2:#142431;
    --khaki:#c4b096;--khaki-deep:#a38d72;--stone:#cfc9be;
    --white:#ffffff;--muted:#6b7280;--muted-2:#9ca3af;
    --border:#e5e7eb;--bg-soft:#f3f4f6;--bg-soft-2:#f9f9f9;
    --maxw:1240px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:#fff;color:var(--ink);font-family:"Manrope",system-ui,-apple-system,sans-serif;
    font-size:1rem;line-height:1.6;-webkit-font-smoothing:antialiased}
  h1,h2,h3{font-family:"Cormorant Garamond","Times New Roman",serif;font-weight:500;line-height:1.1;margin:0}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(1.25rem,4vw,3.5rem)}
  .eyebrow{font-family:"Diodrum","Manrope",sans-serif;font-size:.82rem;letter-spacing:.16em;text-transform:uppercase;color:var(--khaki-deep);font-weight:600;display:block;margin-bottom:1rem}

  /* HEADER */
  .site-header{display:flex;align-items:center;justify-content:space-between;padding:16px clamp(20px,5vw,72px);background:#fff;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,0,0,.06)}
  .site-header img.logo{height:40px;width:auto}
  .cta-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:48px;border-radius:40px;border:none;padding:0 26px;cursor:pointer;transition:all .3s cubic-bezier(.22,1,.36,1);font-family:"Outfit",sans-serif;font-weight:600;font-size:.92rem;box-shadow:0 4px 10px rgba(0,0,0,.1)}
  .cta-button.primary{background:var(--ink);color:#fff}
  .cta-button.primary:hover{background:var(--khaki);color:var(--ink);transform:translateY(-2px);box-shadow:0 12px 28px rgba(196,176,150,.35)}

  /* HERO */
  .hero-background{background:#fff;padding:14px clamp(8px,2vw,16px) 8px}
  .hero{position:relative;background:#e9e4da;height:clamp(520px,74vh,760px);min-height:480px;border-radius:24px;overflow:hidden;display:flex;align-items:flex-end;padding:56px clamp(24px,5vw,72px);max-width:var(--maxw);margin:0 auto;box-shadow:0 8px 32px rgba(0,0,0,.18)}
  .hero-photo{position:absolute;inset:0;z-index:0}
  .hero-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 42%}
  .hero-overlay{position:absolute;inset:0;z-index:1;background:linear-gradient(100deg,rgba(17,24,39,.62) 0%,rgba(17,24,39,.34) 42%,rgba(17,24,39,.02) 68%),linear-gradient(0deg,rgba(17,24,39,.55) 0%,rgba(17,24,39,.05) 45%,transparent 65%)}
  .hero-content{position:relative;z-index:2;max-width:640px}
  .hero-tag{display:inline-block;border:1px solid #fff;border-radius:40px;padding:6px 18px;font-family:"Outfit",sans-serif;font-size:.8rem;margin-bottom:22px;color:#fff;letter-spacing:.08em;text-transform:uppercase}
  .hero-title{font-family:"Avenir","Outfit",sans-serif;font-size:clamp(2rem,4.6vw,3.6rem);font-weight:500;line-height:1.08;color:#fff;margin:0 0 18px;letter-spacing:-.01em;text-shadow:0 2px 14px rgba(0,0,0,.28)}
  .hero-subtitle{font-family:"Diodrum","Manrope",sans-serif;font-size:clamp(1rem,1.6vw,1.15rem);color:#fff;line-height:1.5;margin:0 0 30px;max-width:520px;font-weight:400;text-shadow:0 2px 8px rgba(0,0,0,.35)}
  .hero-cta-wrapper{display:flex;flex-wrap:wrap;gap:14px}
  .hero-cta{background:#fff;color:var(--ink);border:none;border-radius:40px;padding:15px 28px;font-family:"Outfit",sans-serif;font-size:.95rem;font-weight:600;cursor:pointer;box-shadow:0 10px 26px rgba(17,24,39,.18);transition:transform .22s ease}
  .hero-cta:hover{transform:translateY(-2px)}
  .hero-cta.secondary{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.5);backdrop-filter:blur(8px)}
  .hero-cta.secondary:hover{background:#fff;color:var(--ink)}

  /* quick facts strip */
  .quickfacts{display:flex;flex-wrap:wrap;gap:12px;max-width:var(--maxw);margin:22px auto 0;padding:0 clamp(1.25rem,4vw,3.5rem)}
  .qf-pill{display:flex;flex-direction:column;gap:2px;background:var(--bg-soft);border:1px solid var(--border);border-radius:16px;padding:12px 20px}
  .qf-pill .qf-label{font-family:"Diodrum","Manrope",sans-serif;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .qf-pill .qf-value{font-family:"Outfit",sans-serif;font-size:1.05rem;font-weight:600;color:var(--ink)}
  .qf-pill.accent{background:var(--ink);border-color:var(--ink)}
  .qf-pill.accent .qf-label{color:rgba(255,255,255,.6)}
  .qf-pill.accent .qf-value{color:var(--khaki)}

  /* SECTIONS */
  section{padding:clamp(3.5rem,6vw,6.5rem) 0}
  .sec-white{background:#fff}
  .sec-soft{background:var(--bg-soft-2)}
  h2.title{font-size:clamp(1.8rem,1.4rem + 2.2vw,2.9rem);max-width:22ch;font-weight:500;color:var(--ink)}
  .lead-p{max-width:58ch;margin:1.2rem 0 0;color:var(--muted);font-size:1.05rem;line-height:1.65}

  .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:1.8rem 2rem;margin-top:2.8rem}
  .ben{border-top:1px solid var(--border);padding-top:1.3rem}
  .ben .ic{width:26px;height:26px;color:var(--khaki-deep);margin-bottom:.8rem}
  .ben .ic svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .ben h3{font-family:"Outfit",sans-serif;font-size:1.08rem;font-weight:600;margin:0 0 .4rem;color:var(--ink)}
  .ben p{margin:0;font-size:.95rem;color:var(--muted);line-height:1.55}

  .featured{display:grid;grid-template-columns:1fr 1fr;gap:1.6rem;margin-top:3rem}
  .featured figure{margin:0}
  .featured .ph{border-radius:20px;overflow:hidden;border:1px solid var(--border);aspect-ratio:4/5;box-shadow:0 2px 8px rgba(0,0,0,.04)}
  .featured img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  .featured .ph:hover img{transform:scale(1.04)}
  .featured figcaption{margin-top:.8rem;font-family:"Outfit",sans-serif;font-size:.85rem;font-weight:600;color:var(--ink)}
  .featured figcaption span{display:block;font-family:"Manrope",sans-serif;font-weight:400;font-size:.82rem;color:var(--muted);margin-top:.15rem}

  /* stats */
  .data{display:grid;grid-template-columns:repeat(4,1fr);gap:1.4rem;margin-top:2.8rem}
  .stat{background:#fff;border:1px solid var(--border);border-radius:16px;padding:1.4rem 1.2rem}
  .stat-value{font-family:"Cormorant Garamond",serif;font-size:2.1rem;font-weight:600;color:var(--ink-2)}
  .stat-label{font-family:"Diodrum","Manrope",sans-serif;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(20,36,49,.62);margin-top:.35rem}
  .data-foot{margin-top:1.6rem;font-size:.85rem;color:var(--muted);max-width:64ch}

  /* gallery */
  .gallery{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-flow:dense;gap:1.4rem;margin-top:2.8rem}
  .gallery .g-item{margin:0}
  .gallery .ph{border-radius:16px;overflow:hidden;border:1px solid var(--border);aspect-ratio:4/3;box-shadow:0 2px 8px rgba(0,0,0,.04);transition:box-shadow .3s ease,transform .3s ease}
  .gallery .g-item.tall .ph{aspect-ratio:3/4}
  .gallery .g-item.wide{grid-column:span 2}
  .gallery .g-item:hover .ph{transform:translateY(-4px);box-shadow:0 14px 30px rgba(0,0,0,.1);border-color:var(--khaki)}
  .gallery img{width:100%;height:100%;object-fit:cover;display:block}
  .gallery figcaption{margin-top:.7rem;font-family:"Outfit",sans-serif;font-size:.82rem;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:.4rem}
  .gallery figcaption::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--khaki-deep);flex:0 0 auto}

  /* location */
  .map-card{margin-top:2.4rem;display:grid;grid-template-columns:1.1fr .9fr;gap:2.6rem;align-items:center}
  .map-text{max-width:50ch;color:var(--muted);line-height:1.65}
  .map-link{display:inline-flex;align-items:center;gap:8px;margin-top:1.4rem;font-family:"Outfit",sans-serif;font-size:.88rem;font-weight:600;color:var(--ink);text-decoration:none;border-bottom:1px solid var(--khaki-deep);padding-bottom:3px}
  .map-photo{position:relative;overflow:hidden;border-radius:20px;aspect-ratio:4/3;border:1px solid var(--border);box-shadow:0 8px 24px rgba(0,0,0,.08)}
  .map-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .kite-tag{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.4rem;border:1px solid var(--khaki-deep);border-radius:40px;padding:.55rem 1.1rem;font-family:"Outfit",sans-serif;font-size:.82rem;font-weight:600;color:var(--khaki-deep)}
  .kite-tag svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}

  /* steps */
  .steps{margin-top:2.8rem;display:grid;gap:1.2rem}
  .step{display:grid;grid-template-columns:44px 1fr;gap:1.2rem;align-items:start;background:#fff;border:1px solid var(--border);border-radius:16px;padding:1.3rem 1.4rem}
  .step .si{width:36px;height:36px;border-radius:50%;background:var(--khaki);color:var(--ink);display:flex;align-items:center;justify-content:center;font-family:"Outfit",sans-serif;font-weight:700;font-size:.9rem}
  .step h3{font-family:"Outfit",sans-serif;font-size:1.02rem;font-weight:600;margin:0 0 .3rem;color:var(--ink)}
  .step p{margin:0;color:var(--muted);font-size:.94rem;line-height:1.55}

  /* CTA */
  .applysec{background:var(--ink);color:#fff;text-align:center;border-radius:28px;max-width:var(--maxw);margin:0 auto;padding:clamp(3rem,6vw,5rem) clamp(1.5rem,5vw,4rem)}
  .applysec-wrap{padding:0 clamp(1.25rem,4vw,3.5rem)}
  .badge-vagas{display:inline-block;font-family:"Outfit",sans-serif;font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);background:var(--khaki);border-radius:40px;padding:.5rem 1.1rem;margin-bottom:1.3rem;font-weight:600}
  .applysec .title{max-width:none;color:#fff}
  .form-intro{max-width:54ch;margin:1.1rem auto 0;color:rgba(255,255,255,.72)}
  .apply-price{margin-top:2.2rem;font-family:"Cormorant Garamond",serif;font-size:clamp(1.8rem,1.4rem + 1.6vw,2.5rem);color:var(--khaki);font-weight:600}
  .apply-price span{display:block;font-family:"Diodrum","Manrope",sans-serif;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:.6rem;font-weight:400}
  .apply-cta{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;margin-top:2rem}

  /* footer */
  footer.footer-luxo{display:flex;flex-direction:column;width:100%;background:var(--ink);color:#e5e7eb;padding:70px 0 60px;margin-top:0}
  .footer-luxo-logo-wrap{display:flex;justify-content:center;margin-bottom:50px}
  .footer-luxo-logo-wrap img{height:34px;width:auto;filter:invert(1) brightness(2)}
  .footer-luxo-content{max-width:var(--maxw);margin:0 auto;padding:0 clamp(1.25rem,4vw,3.5rem);display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:2rem}
  .footer-luxo-info p{margin:0 0 10px;font-size:.9rem;color:#d1d5db;line-height:1.6}
  .footer-luxo-links h4{margin:0 0 8px;font-size:.78rem;color:var(--khaki);text-transform:uppercase;letter-spacing:.1em;font-family:"Diodrum","Manrope",sans-serif;font-weight:600}
  .footer-social{width:42px;height:42px;border-radius:50%;background:var(--khaki);color:var(--ink);display:flex;align-items:center;justify-content:center}
  .footer-social svg{width:20px;height:20px;fill:currentColor}
  .footer-copyright{margin-top:40px;text-align:center;font-size:.85rem;color:#9ca3af}

  @media(max-width:900px){.gallery{grid-template-columns:repeat(2,1fr)}.map-card{grid-template-columns:1fr}.map-photo{order:-1}}
  @media(max-width:820px){.benefits{grid-template-columns:1fr 1fr}.featured{grid-template-columns:1fr}.data{grid-template-columns:1fr 1fr}}
  @media(max-width:720px){.benefits{grid-template-columns:1fr}.hero{align-items:center;padding:32px 20px}.hero-title{font-size:clamp(1.8rem,7vw,2.6rem)}.footer-luxo-content{flex-direction:column;text-align:center;align-items:center}}
</style>
</head>
<body>

<header class="site-header">
  <img class="logo" src="data:image/png;base64," alt="Terra Ventos">
  <a class="cta-button primary" href="#contato">Falar sobre o imóvel</a>
</header>

<!-- HERO -->
<div class="hero-background">
  <div class="hero">
    <div class="hero-photo"><img src="data:image/jpeg;base64," alt="Casa de frente para o mar em Tatajuba"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-tag">Tatajuba · Ceará · Frente-mar</span>
      <h1 class="hero-title">Uma casa nova, de frente para o mar.</h1>
      <p class="hero-subtitle">Construção recém-concluída em um dos trechos mais preservados do litoral oeste do Ceará.</p>
      <div class="hero-cta-wrapper">
        <a class="hero-cta" href="#contato">Agendar visita</a>
        <a class="hero-cta secondary" href="#a-casa">Ver detalhes</a>
      </div>
    </div>
  </div>
</div>

<div class="quickfacts">
  <div class="qf-pill accent"><span class="qf-label">Valor</span><span class="qf-value">R$ 3.000.000</span></div>
  <div class="qf-pill"><span class="qf-label">Terreno</span><span class="qf-value">~3.100 m²</span></div>
  <div class="qf-pill"><span class="qf-label">Área interna</span><span class="qf-value">115–120 m²</span></div>
  <div class="qf-pill"><span class="qf-label">Quartos · banheiros</span><span class="qf-value">1 · 2</span></div>
</div>

<!-- A CASA -->
<section class="sec-white" id="a-casa">
  <div class="wrap">
    <span class="eyebrow">A casa</span>
    <h2 class="title">Nova, de frente para o mar, pensada para o litoral.</h2>
    <p class="lead-p">Uma construção recente, em estilo tropical, com bastante madeira e grandes aberturas de vidro que trazem o mar para dentro de casa.</p>
    <div class="benefits">
      <div class="ben"><div class="ic"><svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg></div>
        <h3>Suíte / loft no piso superior</h3>
        <p>Um quarto amplo com banheiro, no estilo loft, aproveitando o pé-direito alto e a vista.</p></div>
      <div class="ben"><div class="ic"><svg viewBox="0 0 24 24"><path d="M4 21V9l8-6 8 6v12"/><path d="M9 21v-8h6v8"/></svg></div>
        <h3>Espaço para um 2º quarto</h3>
        <p>O projeto permite a construção de um segundo quarto no térreo, ampliando a casa conforme a necessidade.</p></div>
      <div class="ben"><div class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="12" rx="1"/><path d="M3 8l9-5 9 5"/><path d="M8 20v-6h8v6"/></svg></div>
        <h3>Varanda e área externa</h3>
        <p>Ambientes de convívio integrados ao terreno, com espaço para receber e para churrasqueira.</p></div>
      <div class="ben"><div class="ic"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M4 12h16M12 4v16"/></svg></div>
        <h3>Grandes aberturas de vidro</h3>
        <p>Vãos amplos que conectam os ambientes internos à paisagem e à luz natural do litoral.</p></div>
      <div class="ben"><div class="ic"><svg viewBox="0 0 24 24"><path d="M12 3v18"/><path d="M5 8h14M5 16h14"/></svg></div>
        <h3>Estilo tropical em madeira</h3>
        <p>Estrutura e acabamentos que dialogam com o clima e a paisagem de Tatajuba.</p></div>
      <div class="ben"><div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
        <h3>Construção recém-concluída</h3>
        <p>Casa nova, pronta para morar ou para uso imediato como propriedade de temporada.</p></div>
    </div>
    <div class="featured">
      <figure><div class="ph"><img src="data:image/jpeg;base64," alt="Varanda superior com vista para o mar"></div><figcaption>Varanda<span>Piso superior, vista para o mar</span></figcaption></figure>
      <figure><div class="ph"><img src="data:image/jpeg;base64," alt="Suíte/loft com cama de casal e vista para o mar"></div><figcaption>Suíte / loft<span>Quarto principal</span></figcaption></figure>
    </div>
  </div>
</section>

<!-- FICHA TÉCNICA -->
<section class="sec-soft">
  <div class="wrap">
    <span class="eyebrow">Ficha técnica</span>
    <h2 class="title">Números do imóvel.</h2>
    <div class="data">
      <div class="stat"><div class="stat-value">~3.100 m²</div><div class="stat-label">Área do terreno</div></div>
      <div class="stat"><div class="stat-value">115–120 m²</div><div class="stat-label">Área interna da casa</div></div>
      <div class="stat"><div class="stat-value">1</div><div class="stat-label">Quarto (suíte/loft)</div></div>
      <div class="stat"><div class="stat-value">2</div><div class="stat-label">Banheiros</div></div>
    </div>
    <p class="data-foot">Varanda e área externa com churrasqueira não incluídas na metragem interna. Projeto permite ampliação com um segundo quarto no térreo.</p>
  </div>
</section>

<!-- GALERIA -->
<section class="sec-white" id="galeria">
  <div class="wrap">
    <span class="eyebrow">Galeria</span>
    <h2 class="title">A casa, por dentro.</h2>
    <div class="gallery">
      <div class="g-item tall"><div class="ph"><img src="data:image/jpeg;base64," alt="Vista externa da casa entre árvores, durante o dia"></div><figcaption>Vista externa</figcaption></div>
      <div class="g-item wide"><div class="ph"><img src="data:image/jpeg;base64," alt="Sala de estar ampla com pé-direito alto"></div><figcaption>Sala de estar</figcaption></div>
      <div class="g-item"><div class="ph"><img src="data:image/jpeg;base64," alt="Sala de estar com sofá e TV"></div><figcaption>Estar</figcaption></div>
      <div class="g-item"><div class="ph"><img src="data:image/jpeg;base64," alt="Sala de jantar com mesa para quatro"></div><figcaption>Jantar</figcaption></div>
      <div class="g-item tall"><div class="ph"><img src="data:image/jpeg;base64," alt="Banheiro da suíte, acabamento em cimento queimado"></div><figcaption>Banheiro · suíte</figcaption></div>
      <div class="g-item wide"><div class="ph"><img src="data:image/jpeg;base64," alt="Vista do mar através das portas de vidro"></div><figcaption>Vista pela sala</figcaption></div>
      <div class="g-item"><div class="ph"><img src="data:image/jpeg;base64," alt="Cozinha integrada"></div><figcaption>Cozinha</figcaption></div>
      <div class="g-item"><div class="ph"><img src="data:image/jpeg;base64," alt="Segundo banheiro do piso superior"></div><figcaption>Banheiro · piso superior</figcaption></div>
    </div>
  </div>
</section>

<!-- LOCALIZAÇÃO -->
<section class="sec-soft" id="localizacao">
  <div class="wrap">
    <span class="eyebrow">Localização</span>
    <h2 class="title">Tatajuba, litoral oeste do Ceará.</h2>
    <div class="map-card">
      <div class="map-text">
        <p>Tatajuba fica no litoral oeste do Ceará, em um trecho ainda preservado da costa — dunas, lagoas e mar aberto, na mesma região que atrai investidores e velejadores para o litoral cearense.</p>
        <a class="map-link" href="https://maps.app.goo.gl/pnqkffuhvvbgdxKXA" target="_blank" rel="noopener">Ver localização no Google Maps ›</a>
        <div><span class="kite-tag"><svg viewBox="0 0 24 24"><path d="M3 8c3-4 9-4 12 0"/><path d="M9 3c-1 3 1 6 4 5"/><path d="M21 12c-3 2-3 6 0 9"/><circle cx="12" cy="14" r="1"/></svg>Ventos constantes · região de kitesurf</span></div>
      </div>
      <div class="map-photo"><img src="data:image/jpeg;base64," alt="Vista da varanda para as dunas e o mar"></div>
    </div>
  </div>
</section>

<!-- SITUAÇÃO DOCUMENTAL -->
<section class="sec-white">
  <div class="wrap">
